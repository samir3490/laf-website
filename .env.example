# Learning Library — optional Gemini AI for richer metadata on submissions
# LIBRARY_AI_API_KEY=your-gemini-api-key
# Or: GEMINI_API_KEY=your-gemini-api-key

# Weekly dead-link cron (Vercel sends Authorization: Bearer <CRON_SECRET> automatically)
# CRON_SECRET=generate-a-random-secret-string

# Google Reviews sync — choose ONE path:
#
# A) All reviews (recommended — you own the Google Business profile):
#    1. Google Cloud Console → enable "Google Business Profile API"
#    2. OAuth consent + OAuth client (Web) → run: node scripts/google-business-oauth.mjs
#    3. Set on Vercel:
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# GOOGLE_BUSINESS_REFRESH_TOKEN=
# GOOGLE_BUSINESS_ACCOUNT_ID=accounts/123456789
# GOOGLE_BUSINESS_LOCATION_ID=locations/987654321
#
# B) Latest 5 reviews only (Places API — simpler):
#    1. Enable "Places API (New)" on the same Google Cloud project as Firebase
#    2. Create an API key restricted to Places API
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=   # optional — auto-discovered via text search if omitted
#
# FIREBASE_SERVICE_ACCOUNT_JSON is required for the daily sync cron to write reviews to Firestore.
