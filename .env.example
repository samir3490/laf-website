# Firebase — LAF Website web app (lata-agrawal-foundation project)
# Vercel: Settings → Environment Variables → add all NEXT_PUBLIC_* below
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBDRXPaPrBF0GcbGhjyvErg7i2VIaIBy1s
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lata-agrawal-foundation.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lata-agrawal-foundation
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lata-agrawal-foundation.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=69085237464
NEXT_PUBLIC_FIREBASE_APP_ID=1:69085237464:web:8de8c027a5fe7bd46107ad
# Optional — Firebase Analytics / GA4 (recommended for Google Ads conversion import)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-6QNYDWN2HK
# Or reuse: NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-6QNYDWN2HK

# Google Ads — conversion labels from Google Ads → Goals → Conversions → Tag setup
# Format: AW-17149139381/YourConversionLabel
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-17149139381
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_DONATE=AW-17149139381/REPLACE_DONATE_LABEL
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_DONATE_PAGE=AW-17149139381/REPLACE_DONATE_PAGE_LABEL
# NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LEAD=AW-17149139381/REPLACE_LEAD_LABEL

# Google Search Console — paste only the content value from the HTML tag (not the full <meta> tag)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code-here

# Learning Library — optional Gemini AI for richer metadata on submissions
# LIBRARY_AI_API_KEY=your-gemini-api-key
# Or: GEMINI_API_KEY=your-gemini-api-key

# Weekly dead-link cron (Vercel sends Authorization: Bearer <CRON_SECRET> automatically)
# CRON_SECRET=generate-a-random-secret-string

# Google Reviews — daily cron syncs public Maps metadata to Firestore (no Google API keys required).
# placeId is in src/content/google-business.json; optional override:
# GOOGLE_PLACE_ID=
#
# FIREBASE_SERVICE_ACCOUNT_JSON is required for the daily sync cron to write to Firestore.

# Library emails (copy from donor portal — run: node scripts/sync-gmail-env.mjs)
# GMAIL_USER=admin@agrawalfoundation.org
# GMAIL_APP_PASSWORD=your-google-app-password
# GMAIL_FROM_NAME=Lata Agrawal Foundation
